
<% layout("/layouts/boilerplate") %>

<div class="container new-listing-container">
    <div class="row" mg-3>
        <div class="col-lg-8 col-md-10">

            <h3 class="mb-4">Edit Your Listing</h3>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=PUT"
                novalidate  
                class="needs-validation"
            >

                <!-- Title -->
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>

                    <input
                        id="title"
                        name="listing[title]"
                        value="<%= listing.title %>"
                        placeholder="Enter title"
                        type="text"
                        class="form-control"
                        required
                    >
                     <div class="valid-feedback">title looks good!</div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="listing[description]"
                        placeholder="Enter description"
                        class="form-control"
                        required
                        rows="4"
                    ><%= listing.description || "" %></textarea>
                     <div class="invalid-feedback">please enter a short description</div>
                </div>

                <!-- Image URL -->
                <div class="mb-3">
                    <label for="image" class="form-label">
                        Image Link
                    </label>

                    <input
                        id="image"
                        name="listing[image][url]"
                        value="<%= listing.image?.url || "" %>"
                        placeholder="Enter image URL"
                        type="url"
                        class="form-control"
                        required
                    >
                     <div class="invalid-feedback">please enter a valid link for image</div>
                </div>

                <!-- Price and Country -->
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">
                            Price
                        </label>

                        <input
                            id="price"
                            name="listing[price]"
                            value="<%= listing.price %>"
                            placeholder="Enter price"
                            type="text"
                            min="0"
                            class="form-control"
                            required
                        >
                         <div class="invalid-feedback">please enter a valid price</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">
                            Country
                        </label>

                        <input
                            id="country"
                            name="listing[country]"
                            value="<%= listing.country %>"
                            placeholder="Enter country"
                            type="text"
                            class="form-control"
                            required
                        >
                         <div class="invalid-feedback">please enter a valid country </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="mb-4">
                    <label for="location" class="form-label">
                        Location
                    </label>

                    <input
                        id="location"
                        name="listing[location]"
                        value="<%= listing.location %>"
                        placeholder="Enter location"
                        type="text"
                        class="form-control"
                        required
                    >
                     <div class="invalid-feedback">please enter a valid location</div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-dark add-btn mg-3">
                    Save Changes
                </button>

            </form>

        </div>
    </div>
</div>
<script src="/js/script.js"></script>